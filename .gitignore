# Segredos — NUNCA commitar
.env
.env.*
!.env.example

# Cache do grafo de ruas (gerado automaticamente, pode ter centenas de MB).
# Exceção: cache/grafo_producao.graphml é commitado DE PROPÓSITO — ver
# deploy.md ("Gere o grafo localmente"). Isso evita depender da API do
# Overpass rodando dentro do Render, que se mostrou pouco confiável de lá.
cache/*.graphml
cache/*.graphml.gz
!cache/grafo_producao.graphml

# Logs de verificação (gerados a cada simulação, não fazem parte do código)
logs/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Editor / SO
.vscode/
.DS_Store
Thumbs.db
